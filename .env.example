# Host and port where the local MCP server listens.
MCP_HOST=127.0.0.1
MCP_PORT=3333

# Optional workspace used by your MCP server command.
WORKSPACE_DIR=/absolute/path/to/your/workspace
MCP_AGENT=mcp-workbench
MCP_TOKEN=change-me
# Set to 1 only for local development when you intentionally want no auth.
MCP_ALLOW_NO_AUTH=0
# Allow auth to be supplied via ?auth_token=... when the client cannot send headers.
MCP_ALLOW_QUERY_TOKEN=0
# Set to 1 only if you intentionally want file tools to reach outside WORKSPACE_DIR.
MCP_ALLOW_OUTSIDE_WORKSPACE=0

# Optional override for an external MCP backend command.
# Leave empty to use the bundled server layer in this repo.
# If set, this command replaces the bundled server process.
# Keep it on one line so the scripts can pass it to bash cleanly.
# Example:
# MCP_SERVER_CMD='bun run --cwd /path/to/opencode ./packages/opencode/src/mcp-server/run.ts --directory "$WORKSPACE_DIR" --token "$MCP_TOKEN" --agent "$MCP_AGENT" --allow-write --allow-bash --hostname "$MCP_HOST" --port "$MCP_PORT"'
MCP_SERVER_CMD=

# Async workflow mode for server implementations that support job-based execution.
# When enabled, the server should return quickly with a job/task id and complete work in the background.
MCP_WORKFLOW_MODE=sync
MCP_WORKFLOW_JOB_DIR=.mcp-workbench/jobs
MCP_WORKFLOW_PRESET_DIR=workflow-presets
MCP_SIGNAL_FILTER_DIR=.mcp-workbench/signal-filters
MCP_SIGNAL_TRUST_REGISTRY=~/.config/mcp-workbench/trusted-workspaces.json
MCP_WORKFLOW_POLL_INTERVAL_MS=1000
MCP_JOB_RETENTION_HOURS=24
MCP_JOB_MAX_COUNT=200
MCP_JOB_CLEANUP_INTERVAL_MS=3600000

# Tool gating. Public-safe defaults keep the most dangerous tools off until you enable them.
MCP_ENABLE_WRITE_TOOLS=0
MCP_ENABLE_BASH=0
MCP_SANITIZE_BASH_ENV=1
MCP_ENABLE_WEBFETCH=0
MCP_ENABLE_WORKFLOW=1

# Transport and client behavior.
MCP_RESPONSE_MODE=auto
MCP_MAX_BODY_BYTES=1048576
MCP_ALLOWED_ORIGINS=*

# Optional logs for the helper scripts.
MCP_SERVER_LOG=logs/server.log
MCP_TUNNEL_LOG=logs/tunnel.log

# Tunnel mode: quick or named.
TUNNEL_MODE=quick

# Quick tunnel target. Usually keep this as-is.
TUNNEL_URL=http://127.0.0.1:3333
CLOUDFLARED_EDGE_IP_VERSION=auto
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest

# Named tunnel support.
# Only needed when TUNNEL_MODE=named.
CLOUDFLARED_CONFIG=cloudflared/config.yml

# How long to wait for the local server before the tunnel exits.
MCP_STARTUP_TIMEOUT=60
